# ============================================================

@app.route("/api/track")
def api_track():

    path = get_csv_path()

    if not os.path.exists(path):

        return jsonify([])

    points = []

    try:

        with open(
            path,
            "r",
            encoding="utf-8",
            newline=""
        ) as f:

            reader = csv.DictReader(f)

            for row in reader:

                lat = (
                    row.get("latitude")
                    or ""
                ).strip()

                lon = (
                    row.get("longitude")
                    or ""
                ).strip()

                if not lat or not lon:
                    continue

                try:

                    points.append({

                        "latitude":
                            float(lat),

                        "longitude":
                            float(lon),

                        "session_id":
                            row.get(
                                "session_id"
                            ),

                        "timestamp":
                            row.get(
                                "system_timestamp"
                            ),
                    })

                except Exception:

                    continue

    except Exception as e:

        return jsonify({
            "error": str(e)
        }), 500

    return jsonify(points)


