# API: HISTORICAL DATA
# ============================================================

@app.route("/api/history")
def api_history():

    """
    Get historical GNSS data.

    Example:

        /api/history
        ?date=2026-09-14
        &from=10:00
        &to=17:00

    IMPORTANT:

    system_timestamp in CSV is stored as UTC.

    Example:

        2026-09-14T06:45:34+00:00

    Raspberry Pi in Japan:

        UTC 06:45
            ↓
        JST 15:45

    Therefore this function converts UTC
    to local Raspberry Pi time before filtering.
    """

    date_string = request.args.get(
        "date",
        ""
    )

    from_string = request.args.get(
        "from",
        "00:00"
    )

    to_string = request.args.get(
        "to",
        "23:59"
    )

    session_filter = request.args.get(
        "session",
        "all"
    )

    # ========================================================
    # Validate DATE
    # ========================================================

    try:

        selected_date = datetime.strptime(
            date_string,
            "%Y-%m-%d"
        ).date()

    except ValueError:

        return jsonify({

            "error":
                "Invalid date. "
                "Use YYYY-MM-DD."

        }), 400

    # ========================================================
    # Validate TIME
    # ========================================================

    try:

        start_time = datetime.strptime(
            from_string,
            "%H:%M"
        ).time()

        end_time = datetime.strptime(
            to_string,
            "%H:%M"
        ).time()

    except ValueError:

        return jsonify({

            "error":
                "Invalid time. "
                "Use HH:MM."

        }), 400

    # ========================================================
    # Check time range
    # ========================================================

    if end_time < start_time:

        return jsonify({

            "error":
                "End time must be "
                "greater than start time."

        }), 400

    # ========================================================
    # Build local time range
    # ========================================================

    start_dt = datetime.combine(
        selected_date,
        start_time
    )

    # Include the entire selected end minute.
    #
    # Example:
    #
    # from=10:00
    # to=17:00
    #
    # includes:
    #
    # 10:00:00
    # ...
    # 17:00:59
    #

    end_dt = (
        datetime.combine(
            selected_date,
            end_time
        )
        + timedelta(minutes=1)
    )

    # ========================================================
    # Read ALL CSV files
    # ========================================================

    os.makedirs(
        DATA_DIR,
        exist_ok=True
    )

    points = []

    files_checked = []

    for filename in sorted(
        os.listdir(DATA_DIR)
    ):

        if not filename.lower().endswith(
            ".csv"
        ):
            continue

        path = os.path.join(
            DATA_DIR,
            filename
        )

        if not os.path.isfile(path):
            continue

        files_checked.append(
            filename
        )

        try:

            with open(
                path,
                "r",
                encoding="utf-8",
                newline=""
            ) as f:

                reader = csv.DictReader(
                    f
                )

                for row in reader:

                    # ====================================================
                    # Timestamp
                    # ====================================================

                    timestamp_string = (
                        row.get(
                            "system_timestamp"
                        )
                        or ""
                    ).strip()

                    if not timestamp_string:
                        continue

                    try:

                        dt = (
                            datetime.fromisoformat(
                                timestamp_string.replace(
                                    "Z",
                                    "+00:00"
                                )
                            )
                        )

                        # Old data without timezone
                        # is assumed UTC.
                        if dt.tzinfo is None:

                            dt = dt.replace(
                                tzinfo=timezone.utc
                            )

                    except Exception:

                        continue

                    # ====================================================
                    # UTC -> LOCAL TIME
                    # ====================================================

                    local_dt = (
                        dt.astimezone()
                    )

                    local_naive = (
                        local_dt.replace(
                            tzinfo=None
                        )
                    )

                    # ====================================================
                    # Filter DATE + TIME
                    # ====================================================

                    if local_naive < start_dt:
                        continue

                    if local_naive >= end_dt:
                        continue

                    # ====================================================
                    # Session filter
                    # ====================================================

                    session_id = (
                        row.get(
                            "session_id"
                        )
                        or ""
                    ).strip()

                    if (
                        session_filter != "all"
                        and session_id
                        != session_filter
                    ):
                        continue

                    # ====================================================
                    # Latitude
                    # ====================================================

                    lat_string = (
                        row.get(
                            "latitude"
                        )
                        or ""
                    ).strip()

                    # ====================================================
                    # Longitude
                    # ====================================================

                    lon_string = (
                        row.get(
                            "longitude"
                        )
                        or ""
                    ).strip()

                    # No valid coordinate
                    if (
                        not lat_string
                        or not lon_string
                    ):
                        continue

                    try:

                        latitude = float(
                            lat_string
                        )

                        longitude = float(
                            lon_string
                        )

                    except ValueError:

                        continue

                    # ====================================================
                    # Numeric helpers
                    # ====================================================

                    def to_float(value):

                        try:

                            if value in (
                                None,
                                "",
                                "None"
                            ):
                                return None

                            return float(value)

                        except Exception:

                            return None

                    def to_int(value):

                        try:

                            if value in (
                                None,
                                "",
                                "None"
                            ):
                                return 0

                            return int(
                                float(value)
                            )

                        except Exception:

                            return 0

                    # ====================================================
                    # Create point
                    # ====================================================

                    point = {

                        "id":
                            row.get(
                                "id"
                            ),

                        "sample_index":
                            to_int(
                                row.get(
                                    "sample_index"
                                )
                            ),

                        # Local time
                        "timestamp":
                            local_dt.strftime(
                                "%Y-%m-%d %H:%M:%S"
                            ),

                        # Original UTC timestamp
                        "system_timestamp":
                            row.get(
                                "system_timestamp"
                            ),

                        "gps_time":
                            row.get(
                                "gps_time"
                            ),

                        "latitude":
                            latitude,

                        "longitude":
                            longitude,

                        "altitude":
                            to_float(
                                row.get(
                                    "altitude"
                                )
                            ),

                        "speed_kmh":
                            to_float(
                                row.get(
                                    "speed_kmh"
                                )
                            ) or 0.0,

                        "fix":
                            to_int(
                                row.get(
                                    "fix"
                                )
                            ),

                        "satellites":
                            to_int(
                                row.get(
                                    "satellites"
                                )
                            ),

                        "hdop":
                            to_float(
                                row.get(
                                    "hdop"
                                )
                            ),

                        "gps_lost":
                            str(
                                row.get(
                                    "gps_lost",
                                    ""
                                )
                            ).lower()
                            == "true",

                        "session_id":
                            session_id,

                        "source_file":
                            filename,
                    }

                    points.append(
                        point
                    )

        except Exception as e:

            print(
                f"[HISTORY] Error reading "
                f"{filename}: {e}"
            )

    # ========================================================
    # Sort chronologically
    # ========================================================

    points.sort(
        key=lambda p:
            p.get(
                "timestamp"
            ) or ""
    )

    # ========================================================
    # Remove duplicate points
    # ========================================================

    unique_points = []

    seen = set()

    for point in points:

        key = (

            point["timestamp"],

            point["latitude"],

            point["longitude"],

            point["session_id"],
        )

        if key in seen:
            continue

        seen.add(key)

        unique_points.append(
            point
        )

    points = unique_points

    # ========================================================
    # Sessions
    # ========================================================

    sessions = sorted({

        p["session_id"]

        for p in points

        if p.get(
            "session_id"
        )
    })

    # ========================================================
    # Debug information
    # ========================================================

    print()
    print(
        "[HISTORY]"
    )

    print(
        f"Date       : {date_string}"
    )

    print(
        f"Time       : "
        f"{from_string} -> {to_string}"
    )

    print(
        f"Files      : "
        f"{len(files_checked)}"
    )

    print(
        f"Points     : "
        f"{len(points)}"
    )

    print(
        f"Sessions   : "
        f"{len(sessions)}"
    )

    if files_checked:

        print(
            "[HISTORY] Files:"
        )

        for filename in files_checked:

            print(
                f"  - {filename}"
            )

    print()

    # ========================================================
    # Return JSON
    # ========================================================

    return jsonify({

        "date":
            date_string,

        "from":
            from_string,

        "to":
            to_string,

        "count":
            len(points),

        "sessions":
            sessions,

        "files_checked":
            files_checked,

        "points":
            points,
    })


