# ==============================================================================
# NARO GPS Logger - Device Specific Configuration (.env)
# ==============================================================================
# Copy this file to '.env' on each Raspberry Pi:
#   cp .env.example .env
#
# Then customize the values below for this specific device/collar.
# Note: '.env' is ignored by git and will NOT be overwritten during git pull.
# ==============================================================================

# Unique hardware device identifier (e.g. PI-NARO-001, PI-NARO-002)
NARO_DEVICE_ID=PI-NARO-001

# Subject / Animal collar identifier (e.g. COW-NARO-001, COW-NARO-002)
NARO_SUBJECT_ID=COW-NARO-001

# Bluetooth MAC address of the Drogger DG-PRO1S paired with this Pi
# (Run 'bluetoothctl devices' to find the MAC address of your receiver)
NARO_DROGGER_MAC=94:51:DC:57:BE:12

# Subject tracking profile: 'cow' or 'human'
NARO_PROFILE=cow

# Target GPS sampling frequency in Hz (1 for cattle tracking, 10 for high-frequency motion)
NARO_HZ=1

# Local Web Monitor Dashboard port (default: 8000)
NARO_WEB_PORT=8000
